{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git filter-branch:*)",
      "Bash(mkfs:*)",
      "Bash(dd if=:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "안전 검사",
            "timeout": 10,
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/guard.js\""
          }
        ]
      }
    ]
  }
}