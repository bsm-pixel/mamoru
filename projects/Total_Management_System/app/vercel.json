{
  "ignoreCommand": "bash -c 'git diff --quiet $VERCEL_GIT_PREVIOUS_SHA $VERCEL_GIT_COMMIT_SHA -- . 2>/dev/null || exit 1'",
  "crons": [
    {
      "path": "/api/cron/sync-orders",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/track-delivery",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/imweb-token-refresh",
      "schedule": "0 */12 * * *"
    }
  ]
}
